{
  "name": "@diegomodesto/ns",
  "version": "0.0.0",
  "description": "TypeScript-first CLI for NetSuite SuiteCloud projects, built on top of the SuiteCloud CLI",
  "keywords": [
    "netsuite",
    "suitescript",
    "suitecloud",
    "sdf",
    "typescript",
    "cli"
  ],
  "author": "Diego Modesto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiegoModesto/ns-cli.git"
  },
  "homepage": "https://github.com/DiegoModesto/ns-cli#readme",
  "bugs": {
    "url": "https://github.com/DiegoModesto/ns-cli/issues"
  },
  "type": "module",
  "bin": {
    "nsk": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "snippets"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.templates.json",
    "test": "vitest run",
    "sync:templates": "node scripts/sync-templates.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "execa": "^10.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hitc/netsuite-types": "^2026.2.4",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
