      "define(['N/log'], (log) => {",
      "",
      "\tconst getInputData = (context) => {",
      "\t\t$0",
      "\t};",
      "",
      "\tconst map = (context) => {};",
      "",
      "\tconst reduce = (context) => {};",
      "",
      "\tconst summarize = (summary) => {",
      "\t\tif (summary.inputSummary.error) {",
      "\t\t\tlog.error({ title: 'getInputData', details: summary.inputSummary.error });",
      "\t\t}",
      "\t\tsummary.mapSummary.errors.iterator().each((key, error) => {",
      "\t\t\tlog.error({ title: `map: \\${key}`, details: error });",
      "\t\t\treturn true;",
      "\t\t});",
      "\t\tsummary.reduceSummary.errors.iterator().each((key, error) => {",
      "\t\t\tlog.error({ title: `reduce: \\${key}`, details: error });",
      "\t\t\treturn true;",
      "\t\t});",
      "\t};",
      "",
      "\treturn {",
      "\t\tgetInputData,",
      "\t\tmap,",
      "\t\treduce,",
      "\t\tsummarize",
      "\t};",
      "});"
    ]
