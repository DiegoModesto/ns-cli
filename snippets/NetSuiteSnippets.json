{
	"Console: Inject NetSuite Modules": {
		"scope": "javascript,typescript",
		"prefix": "nsInject",
		"description": "Carrega os módulos N/* em variáveis globais para debug no console do navegador",
		"body": [
			"var record, search, query, format, http, https, runtime, urlmod;",
			"require(['N/record', 'N/search', 'N/query', 'N/format', 'N/http', 'N/https', 'N/runtime', 'N/url'], (...modules) => {",
			"\t[record, search, query, format, http, https, runtime, urlmod] = modules;",
			"});"
		]
	},

